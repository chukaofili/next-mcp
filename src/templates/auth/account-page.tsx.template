import { Settings } from "@/components/auth/settings/settings";

/**
 * Account/settings views provided by the shadcn-registry install of better-auth-ui:
 * /account/settings, /account/security
 *
 * Additional views (api-keys, organizations, etc) are resolved by <Settings />
 * when the matching plugin is registered.
 */

interface AccountPageProps {
  params: Promise<{ path: string }>;
}

export default async function AccountPage({ params }: AccountPageProps) {
  const { path } = await params;
  return (
    <main className="container flex min-h-screen">
      <div className="flex grow flex-col p-4 md:p-6">
        <Settings path={path} />
      </div>
    </main>
  );
}
