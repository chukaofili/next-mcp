{
  "name": "@<projectName>/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "clean": "rm -rf *.tsbuildinfo",
    "ui:add": "npx shadcn@latest add"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1",
    "class-variance-authority": "^0",
    "clsx": "^2",
    "lucide-react": "^0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@<projectName>/eslint-config": "workspace:*",
    "@<projectName>/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "catalog:"
  }
}
