{
  "name": "@<projectName>/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./exports": {
      "types": "./src/re-exports.ts",
      "default": "./src/re-exports.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "clean": "rm -rf *.tsbuildinfo"
  },
  "dependencies": {
    "@<projectName>/db": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@<projectName>/eslint-config": "workspace:*",
    "@<projectName>/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
